sponding to your Keras YOLOv11 model's data flow\n","        x = self.conv1(x)\n","        x = self.relu1(x)\n","        # ... continue with other layers of your YOLOv11 forward pass ...\n","        return x\n","\n","# 2. Load .h5 weights and map to PyTorch\n","# Ensure 'model.h5' is uploaded to your Colab environment or provide the correct path.\n","# Instantiate the custom PyTorch model for YOLOv11.\n","pytorch_model_from_keras = YOLOv11KerasConverted()\n","\n","h5_file = h5py.File('model.h5', 'r') # Assuming 'model.h5' is the Keras model file\n","pytorch_state_dict = pytorch_model_from_keras.state_dict()\n","\n","# This part needs careful mapping. The exact keys in h5_file['model_weights']\n","# will depend on how the Keras model was saved and its layer names.\n","# You might need to inspect the .h5 file structure (e.g., using `h5_file.visit(lambda name: print(name, type(h5_file[name])))`)\n","# to find the correct weight keys and map them to PyTorch layer names.\n","\n","# Example mapping (this will definitely need adjustment for your specific YOLOv11 Keras model):\n","for name, param in h5_file['model_weights'].items():\n","    # Keras typically stores weights and biases separately, e.g., 'conv2d_1/kernel:0', 'conv2d_1/bias:0'\n","    # You need to map these to PyTorch's 'conv1.weight', 'conv1.bias' or whatever your PyTorch layers are named.\n","\n","    # Example: Mapping a convolutional layer's weights and bias\n","    if 'conv1' in name and 'kernel:0' in name:\n","        # Keras weights for Conv2D are usually (height, width, in_channels, out_channels)\n","        # PyTorch weights for Conv2d are (out_channels, in_channels, height, width)\n","        weight = torch.from_numpy(param[()]).permute(3, 2, 0, 1)\n","        pytorch_state_dict['conv1.weight'].copy_(weight)\n","    elif 'conv1' in name and 'bias:0' in name:\n","        bias = torch.from_numpy(param[()])\n","        pytorch_state_dict['conv1.bias'].copy_(bias)\n","    # Add more `elif` blocks for other layers (batch normalization, dense layers, etc.)\n","    # Each layer type might require a different permutation or direct copy.\n","    # For a full YOLOv11, this mapping will be extensive.\n","\n","pytorch_model_from_keras.load_state_dict(pytorch_state_dict, strict=False) # Use strict=False if some keys don't match exactly\n","\n","print(\"Keras .h5 model converted to generic PyTorch model successfully!\")\n","\n","# 3. Save the converted PyTorch model's state_dict\n","# This saves only the weights and biases in a generic PyTorch format.\n","# It's NOT yet an Ultralytics-compatible checkpoint.\n","torch.save(pytorch_model_from_keras.state_dict(), 'yolov11_keras_converted_weights.pt')\n","print(\"Generic PyTorch model weights saved as 'yolov11_keras_converted_weights.pt'\")\n","\n","# Optional: Display a summary of the PyTorch model\n","# from torchsummary import summary # You might need to install torchsummary: pip install torchsummary\n","# summary(pytorch_model_from_keras, (3, 640, 640)) # Adjust input size (channels, height, width) as per your YOLOv11 model"],"id":"58fe5c79"},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ecb12583","executionInfo":{"status":"ok","timestamp":1784990415918,"user_tz":300,"elapsed":14050,"user":{"displayName":"Stuart Fairchild","userId":"05554423093085130993"}},"outputId":"72d2e027-3457-424e-da2b-108a73077ad3"},"source":["# Install Ultralytics if you haven't already\n","!pip install ultralytics\n","\n","import torch\n","from ultralytics import YOLO\n","\n","# Assuming you have the 'yolov11_keras_converted_weights.pt' file from the previous step\n","# and you've accurately defined the YOLOv11KerasConverted class to match your Keras model.\n","\n","# 1. Instantiate your PyTorch model with the converted Keras weights\n","# You need to ensure the YOLOv11KerasConverted class defined previously is available in the current scope.\n","# If you run this cell independently, you might need to re-define